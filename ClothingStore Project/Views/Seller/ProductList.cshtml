@model IEnumerable<ClothingStore_Project.Models.Product>

<h2>Product List</h2>

<table class="table table-bordered">
    <tr>
        <th>Product Name</th>
        <th>Price</th>
        <th>Brand</th>
        <th>Size</th>
        <th>Colour</th>
        <th>Quantity</th>
        <th>Description</th>
        <th>Image</th>
        <th>Action</th>
        <td>

    </tr>

@foreach (var item in Model)
    {
        <tr>
            <td>@item.ProductName</td>
            <td>@item.Price</td>
            <td>@item.Brand</td>
            <td>@item.Size</td>
            <td>@item.Colour</td>
            <td>@item.Quantity</td>
            <td>@item.Description</td>

            <td>
                <img src="/images/@item.ImageUrl.Split( ',')[0]" width="100" height="100" />
            </td>

            <td>
                <a asp-action="EditProduct"
                   asp-route-id="@item.ProductId"
                   class="btn btn-warning">
                    Edit
                </a>

                <a asp-action="DeleteProduct"
                   asp-route-id="@item.ProductId"
                   class="btn btn-danger">
                    Delete
                </a>
            </td>
        </tr>
        }
        </table>
        <br />

        <a href="/Home/Products" class="btn btn-primary">
            View Products
        </a>

        <a href="/Home/Index" class="btn btn-success">
            Go To Home
        </a>
<br />
<br />

<a href="/Home/OrderList" class="btn btn-info">
    View Orders
</a>
}

@model ClothingStore_Project.Models.Product

<h2>Delete Product</h2>

<h4>Are you sure you want to delete this product?</h4>

<div>
    <p><b>Product Name:</b> @Model.ProductName</p>
    <p><b>Price:</b> @Model.Price</p>
    <p><b>Brand:</b> @Model.Brand</p>

    <img src="@Model.ImageUrl" width="150" height="150" />

    <form asp-action="DeleteProduct" method="post">

        <input type="hidden" asp-for="ProductId" />

        <br />

        <button type="submit" class="btn btn-danger">
            Delete
        </button>

    </form>
</div>
@model List<ClothingStore_Project.Models.Seller>

<h2>Sellers List</h2>

<table class="table table-bordered">

    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Phone</th>
            <th>Shop Name</th>
            <th>Address</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Name</td>
                <td>@item.Email</td>
                <td>@item.Phone</td>
                <td>@item.ShopName</td>
                <td>@item.Address</td>
                <td>

                    <a href="/Seller/EditSeller/@item.Id"
                       class="btn btn-primary">
                        Edit
                    </a>

                    <a href="/Seller/DeleteSeller/@item.Id"
                       class="btn btn-danger">
                        Delete
                    </a>

                    <a href="/Seller/SellerDetails/@item.Id"
                       class="btn btn-info">
                        Details
                    </a>

                </td>
            </tr>
        }

    </tbody>

</table>
@model ClothingStore_Project.Models.Product

<h2>Add Product</h2>

<form method="post">

    <div class="form-group">
        <label>Product Name</label>
        <input asp-for="ProductName"
               class="form-control" />
    </div>

    <div class="form-group">
        <label>Price</label>
        <input asp-for="Price"
               class="form-control" />
    </div>

    <div class="form-group">
        <label>Brand</label>
        <input asp-for="Brand"
               class="form-control"
                value="@ViewBag.Brand" />
    </div>

    <div class="form-group">
        <label>Image Url</label>
        <input asp-for="ImageUrl"
               class="form-control" />
    </div>
    <label>Size</label>
    <input asp-for="Size" class="form-control" />
    <br />

    <label>Colour</label>
    <input asp-for="Colour" class="form-control" />
    <br />

    <label>Quantity</label>
    <input asp-for="Quantity" class="form-control" />
    <br />

    <label>Description</label>
<textarea asp-for="Description" class="form-control"></textarea>
    <br />

    <button type="submit"
            class="btn btn-primary">
        Save Product
    </button>

</form>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - DAMMA VYAPARA </title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ClothingStore_Project.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-dark bg-dark shadow">
            <div class="container-fluid">
                <a class="navbar-brand d-flex align-items-center"
                   asp-area=""
                   asp-controller="Home"
                   asp-action="Index">

                    <img src="~/images/Home/logo2.jpeg"
                         width="45"
                         height="45"
                         style="border-radius:50%; margin-right:10px;" />

                    <span style="font-size:24px; font-weight:bold; color:white;">
                        DAMMA VYAPARA
                    </span>

                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="Index"><i class="bi bi-house-fill"></i>Home</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="Products"><i class="bi bi-bag-fill"></i>Products</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="Brands"><i class="bi bi-tags-fill"></i>Brands</a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="Contact"><i class="bi bi-telephone-fill"></i>Contact Us</a>
                        </li>

                    </ul>

                    <ul class="navbar-nav">

                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container"/>
        <main role="main" class="pb-3">
            @RenderBody()
        </main>

        <footer class="footer bg-dark text-white mt-5">

            <div class="container py-4">

                <div class="row">

                    <div class="col-md-4">

                    <h5><i class="bi bi-shop"></i>DAMMA VYAPARA</h5>

                    <p><i class="bi bi-bag-heart-fill"></i>Quality Fashion at Affordable Prices.</p>

                    </div>

                    <div class="col-md-4">

                    <h5><i class="bi bi-link-45deg"></i>Quick Links</h5>

                        <ul class="list-unstyled">

                        <li><a asp-controller="Home" asp-action="About" class="text-white"><i class="bi bi-info-circle"></i>About</a></li>

                        <li><a asp-controller="Home" asp-action="Contact" class="text-white"><i class="bi bi-telephone"></i>Contact</a></li>

                        <li><a asp-controller="Home" asp-action="Privacy" class="text-white"><i class="bi bi-shield-lock"></i>Privacy Policy</a></li>

                        <li><a asp-controller="Home" asp-action="Terms" class="text-white"><i class="bi bi-file-earmark-text"></i>Terms & Conditions</a></li>

                        </ul>

                    </div>

                    <div class="col-md-4">

                    <h5><i class="bi bi-person-lines-fill"></i>Contact</h5>

                    <p><i class="bi bi-envelope-fill"></i>Email : askhosiries@gmail.com</p>

                    <p><i class="bi bi-telephone-fill"></i>Phone : +91 8099960188</p>

                    <p><i class="bi bi-phone-fill"></i> +91 7013802936</p>

                    </div>

                </div>

                <hr class="bg-white" />

                <div class="text-center">

                <i class="bi bi-c-circle"></i>© 2026 DAMMA VYAPARA. All Rights Reserved.

                </div>

            </div>

        </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

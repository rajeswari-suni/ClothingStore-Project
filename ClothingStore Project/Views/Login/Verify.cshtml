<h2>Verify OTP</h2>

<p>Mobile Number: @ViewBag.MobileNumber</p>

<form method="post" asp-action="VerifyOTP">

    <input type="hidden" name="mobileNumber" value="@ViewBag.MobileNumber" />
    <input type="hidden" name="role" value="@Context.Session.GetString("Role")" />

    <div>
        <label>Enter OTP</label>

        <input type="text"
               name="userOTP"
               placeholder="Enter OTP" />
    </div>fd

    <br />

    <button type="submit">Verify OTP</button>

    <p id="timer">Resend OTP in 30 sec</p>

    <button id="resendBtn"
            type="button"
            onclick="location.href='/Login/SendOTP?mobileNumber=@ViewBag.MobileNumber'"
            disabled>
        Resend OTP
    </button>

</form>

<script>

    let seconds = 30;

    let timer = setInterval(function () {

        document.getElementById("timer").innerText =
            "Resend OTP in " + seconds + " sec";

        seconds--;

        if (seconds < 0)
        {
            clearInterval(timer);

            document.getElementById("timer").innerText =
                "You can resend OTP";

            document.getElementById("resendBtn").disabled = false;
        }

    }, 1000);

</script>
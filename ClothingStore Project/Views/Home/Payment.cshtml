<form action="/Home/OrderSuccess"method="post">
<h3>Select Payment Method:</h3>

<input type="radio" name="payment" value="COD" onclick="showPayment('cod')" required /> Cash on Delivery
<br />
<br />

<input type="radio" name="payment" value="UPI" onclick="showPayment('upi')" /> UPI
<br />
<br />

<!-- UPI FIELD -->
   <div id="upiSection" style="display:none;">

        <h3>UPI Payment</h3>

        <p>
            UPI ID :
            <b>9989927688-3@ibl</b>
        </p>
        <img src="https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=upi://pay?pa=9989927688-3@ibl&pn=ASKHOSIRIES"
             width="200" height="200" />

           <br /><br />

        <input type="text"
               placeholder="Enter Transaction ID" />
    </div>

<!-- BUTTON -->
<button id="actionBtn" type="submit" style="padding:10px 20px; background-color:green; color:white;">
    Pay Now
</button>
</form>
<script>

    function showPayment(type) {

        document.getElementById("upiSection").style.display = "none";

        let btn = document.getElementById("actionBtn");

        if (type === "cod") {

            btn.innerText = "Place Order";
        }

        else if (type === "upi") {

            document.getElementById("upiSection").style.display = "block";

            btn.innerText = "Pay Now";
        }
    }

</script>
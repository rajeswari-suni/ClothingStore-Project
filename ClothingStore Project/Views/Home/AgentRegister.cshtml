@model ClothingStore_Project.Models.Agent

<h2>Agent Registration</h2>

<form method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <label>Name</label>
    <input type="text" asp-for="Name" class="form-control" />
    <snap asp-validation-for="Name" class="text-danger"></snap>
    <br />

    <label>Email</label>
    <input type="email" asp-for="Email" class="form-control" />
    <snap asp-validation-for="Email"class="text-danger"></snap>
    <br />

    <label>Phone</label>
    <input type="text" asp-for="Phone" class="form-control" />
    <snap asp-validation-for="Phone" class="text-danger"></snap>
    <br />

    <label>Subscription Amount</label>

    <select asp-for="SubscriptionAmount"
            class="form-control"
            id="amountDropdown">

        <option value="">Select Amount</option>
        <option value="5000">5000</option>
        <option value="10000">10000</option>
        <option value="15000">15000</option>

    </select>
    <br />


    <label>Membership Type</label>

    <input asp-for="MembershipType"
           class="form-control"
           id="membership"
           readonly />

    <br />


    <label>Discount Percentage</label>

    <input type="number"
           asp-for="DiscountPercentage"
           class="form-control"
           id="discount"
           readonly />

    <br />

    <button type="submit" class="btn btn-primary">
        Register
    </button>
    
    <script>

        document.getElementById("amountDropdown")
        .addEventListener("change", function () {

            var amount = this.value;

            if (amount == "5000")
            {
                document.getElementById("membership").value = "Gold";
                document.getElementById("discount").value = 30;
            }

            else if (amount == "10000")
            {
                document.getElementById("membership").value = "Platinum";
                document.getElementById("discount").value = 50;
            }

            else if (amount == "15000")
            {
                document.getElementById("membership").value = "Diamond";
                document.getElementById("discount").value = 70;
            }

        });

    </script>

</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}

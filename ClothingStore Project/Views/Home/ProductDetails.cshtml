@model ClothingStore_Project.Models.Product
<h2 style="text-align:center;">Product Details</h2>

@{
    var images = Model.ImageUrl.Split(',');
}

<div style="margin-top:40px;text-align:center;">

    <div>

<img id="productImage"
     src="/images/@images[0]"
     width="350" />

</div>
</div>
<div style="margin-top:15px;
            display:flex;
            gap:10px;
            justify-content:center;">

@for(int i=0;i<images.Length;i++)
{
    <img src="/images/@images[i]"
         width="70"
         style="cursor:pointer;
                border:1px solid gray;
                padding:4px;"

         onclick="changeImage('@images[i]',this)" />
}

</div>
      <h3>@Model.ProductName</h3>
      <h4>₹ @Model.Price</h4>
      
      <p style="color:green;font-weight:bold;">
          ⭐ 4.5 (120 Reviews)
      </p>

      <p>
          <b>Description:</b>
      </p>
      
      <p style="width:400px;">
          @Model.Description
      </p>

  @if (Model.Quantity == 0)
  {
      <p style="color:red;font-weight:bold;font-size:18px;">
          Sorry! This item is currently out of stock.
      </p>
  }

<br />

<p><b>Select Size</b></p>

@foreach (var size in Model.Size.Split(','))
{
    <button class="sizeBtn"
            onclick="selectSize(this)">
        @size
    </button>
}
<br>
<br>

<p><b>Select Colour</b></p>

@foreach (var color in Model.Colour.Split(','))
{
    <button type="button"
            class="colorBtn"
            onclick="selectColor(this)">
        @color
    </button>
}

<br />
<br />
<form method="post" asp-action="BuyNow" asp-controller="Home">

    <input type="hidden" name="product" value="@Model.ProductName" />
    <input type="hidden" name="price" value="@Model.Price" />

    <input type="hidden" id="selectedSize" name="size" />
    <input type="hidden" id="selectedColor" name="color" />

    <label>Quantity:</label>
    <input type="number" id="qty" name="qty" value="1" min="1" style="width:60px;margin-bottom:10px;" />

    <p style="margin-top:10px;">
        Estimated Delivery:
        @{
            var deliveryDate = DateTime.Now.AddDays(5);
        }
        @deliveryDate.ToString("dd MMM yyyy")
    </p>

    <br />

    @if (Model.Quantity == 0)
    {
        <button disabled
                style="padding:10px 20px; background-color:gray; color:white;">
            Add To Cart
        </button>

        <button disabled
                style="padding:10px 20px; background-color:gray; color:white; margin-left:10px;">
            Buy Now
        </button>
    }
    else
    {
        <button type="submit"
                formaction="/Home/AddToCart"
                style="padding:10px 20px; background-color:blue; color:white;">
            Add To Cart
        </button>

        <button type="submit"
                formaction="/Home/BuyNow"
                style="padding:10px 20px; background-color:blue; color:white; margin-left:10px;">
            Buy Now
        </button>
    }
    </form>

<script>

        function changeImage(img){

        document.getElementById("productImage").src =
            "/images/" + img;

        var colorName = img.split("-")[0];

        var buttons =
            document.getElementsByClassName("colorBtn");

        for(var i=0;i<buttons.length;i++){

            buttons[i].style.background="";
            buttons[i].style.color="";

            if(buttons[i].innerText.toLowerCase() ==
               colorName.toLowerCase()){

                buttons[i].style.background="black";
                buttons[i].style.color="white";

                document.getElementById("selectedColor").value =
                    buttons[i].innerText;
            }
        }
    }

    function selectSize(btn){

        var buttons = document.getElementsByClassName("sizeBtn");

        for(var i=0;i<buttons.length;i++){
            buttons[i].style.background="";
            buttons[i].style.color="";
        }

        btn.style.background="black";
        btn.style.color="white";

        document.getElementById("selectedSize").value =
            btn.innerText;
    }

    function selectColor(btn){

        var buttons =
            document.getElementsByClassName("colorBtn");

        for(var i=0;i<buttons.length;i++){
            buttons[i].style.background="";
            buttons[i].style.color="";
        }

        btn.style.background="black";
        btn.style.color="white";

        document.getElementById("selectedColor").value =
            btn.innerText;
    }

</script>     
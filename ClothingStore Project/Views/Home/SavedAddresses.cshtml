@model ClothingStore_Project.Models.AddressDetails

<div class="container mt-4">
    <h2>My Address</h2>
    <hr />

    <div class="card p-4">

        <p><strong>Name:</strong> @Model.Name</p>

        <p><strong>Mobile:</strong> @Model.Mobile</p>

        <p><strong>Door No:</strong> @Model.DoorNumber</p>

        <p><strong>Address:</strong> @Model.AddressLine</p>

        <p><strong>City:</strong> @Model.City</p>

        <p><strong>State:</strong> @Model.State</p>

        <p><strong>Landmark:</strong> @Model.Landmark</p>

        <p><strong>Pincode:</strong> @Model.Pincode</p>

        <hr />

        <a href="/Home/EditAddress" class="btn btn-warning">
            <i class="bi bi-pencil-square"></i> Edit
        </a>

        <a href="/Home/DeleteAddress"
           class="btn btn-danger"
           onclick="return confirm('Delete Address?')">
            <i class="bi bi-trash-fill"></i> Delete
        </a>

        <a href="/Home/Address"
           class="btn btn-success">
            <i class="bi bi-plus-circle-fill"></i> Add New Address
        </a>
    </div>
</div>
@using Microsoft.AspNetCore.Http
<style>
    body {
        margin: 0;
        font-family: Arial;
        background: linear-gradient(135deg, #fdfbfb, #ebedee);
        animation: fadeIn 1s ease-in;
    }

    @@keyframes fadeIn {
        from {
            opacity: 0;
        }

        to {
            opacity: 1;
        }
    }

    /* Page Border */
    .page-container {
        margin: 10px auto;
        max-width: 1200px;
        border: none;
        border-radius: 0;
    }

    /* Navbar */
    .navbar {
        background-color: #131921;
        color: white;
        padding: 15px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .navbar a {
            color: white;
            text-decoration: none;
            margin: 0 10px;
        }

            .navbar a:hover {
                color: orange;
            }

    /* Search */
    .search-box {
        padding: 5px;
        border-radius: 5px;
        border: none;
    }

    /* Hero */
    .hero {
        width: 100%;
        min-height: 450px;
        padding: 50px 20px;
        text-align: center;
        background: linear-gradient(to bottom,#2d8cff,#8fd3ff,#dff4ff);
        color: white;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        border-radius: 10px;
    }

        .hero h1 {
            background: linear-gradient(to right, #ffffff, #e3f2fd);
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            font-size: 36px;
        }

    /* Slider */
    #slider {
        width: 200px;
        height: 200px;
        object-fit:cover;
        border-radius: 10px;
        margin-top: 20px 0;
    }

    /* Button */
    .btn {
        padding: 10px 20px;
        background: orange;
        color: white;
        border-radius: 5px;
        text-decoration: none;
        display: inline-block;
        margin-top: 10px;
        transition: 0.3s;
    }

        .btn:hover {
            background: #ff3d00;
            box-shadow: 0 0 10px orange;
        }

    /* Brands Section */
    .brands {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin: 30px;
        flex-wrap: wrap;
    }

    .brand-card {
        background: white;
        border-radius: 15px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.12);
        transition: .3s;
    }

        .brand-card:hover {
            transform: translateY(-6px);
            box-shadow: 0 10px 25px rgba(0,0,0,.2);
        }

    /* Products */
    .products {
        display: flex;
        justify-content: center;
        gap: 20px;
        margin: 30px;
        flex-wrap: wrap;
    }

    .card {
        background: white;
        width: 200px;
        padding: 15px;
        border-radius: 10px;
        text-align: center;
        box-shadow: 0 0 10px rgba(0,0,0,0.1);
        transition: 0.3s;
    }

        .card:hover {
            transform: translateY(-10px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.2);
        }

        .card img {
            width: 100%;
            height: 180px;
            object-fit: cover;
            border-radius: 10px;
            transition: 0.3s;
        }

            .card img:hover {
                transform: scale(1.1);
            }
</style>

        <div class="page-container">

    <!-- NAVBAR -->
    <div class="navbar">

        <div style="display:flex; align-items:center; gap:15px;">
            <b><i class="bi bi-shop"></i>MyShop 🛍️</b>
            <form method="get" action="/Home/Products">
                <input type="text" name="type" class="search-box" placeholder="Search products..." />               
            </form>
        </div>

        <div>
            <a href="/Home/Index"><i class="bi bi-house-fill"></i>Home</a>
            <a href="/Home/Products"><i class="bi bi-bag-fill"></i>Products</a>

    @{
        var role = Context.Session.GetString("UserRole");
    }

    @if (role == "Buyer" || role == "Agent")
    {
        <a href="/Home/Cart"><i class="bi bi-cart-fill"></i>Cart</a>
        <a href="/Home/MyOrders"><i class="bi bi-box-seam-fill"></i>My Orders</a>
        <a href="/Home/MyAccount"><i class="bi bi-person-circle"></i>My Account</a>
        <a href="/Seller/Logout"><i class="bi bi-arrow-right"></i>Logout</a>
    }
    else if (role == "Seller")
    {
        <a href="/Seller/Dashboard"><i class="bi bi-speedometer2"></i>Dashboard</a>
        <a href="/Home/Logout"><i class="bi bi-arrow-right"></i>Logout

        </a>
    }
    else
    {
        <a href="/Login"><i class="bi bi-box-arrow-in-right"></i>Login
    
        </a>
    }
        </div>
        </div>
 
        <!-- HERO -->
    <div class="hero">
        <h1>Welcome to Fashion Store</h1>
        <p><i class="bi bi-patch-check-fill"></i>Best Brands &nbsp;|&nbsp;<i class="bi bi-tags-fill"></i> Best Prices</p>

        <img id="slider" src="/images/red-tshirt.jpg" />

        <br />

    <a href="/Home/Products" class="btn"><i class="bi bi-bag-fill"></i>Shop Now</a>
    </div>
    </div>

    <!-- SLIDER SCRIPT -->
    <script>
        var images = [
            "/images/red-tshirt.jpg",
            "/images/Black-Innerwear.jpg",
            "/images/Black-Shorts.jpg",
            "/images/Black-Banyan.jpg"
        ];

        var i = 0;

        setInterval(function () {
            i = (i + 1) % images.length;
            document.getElementById("slider").src = images[i];
        }, 2000);
    </script>


<h2 style="text-align:center;">Order Summary</h2>

<div style="width:60%; margin:auto;">

@if (ViewBag.Products != null)
{
        <!-- CART FLOW -->
        <h3>Products Details:</h3>
        @if (ViewBag.Products != null)
        {
            for (int i = 0; i < ViewBag.Products.Count; i++)
            {
                <p><b>Product:</b> @ViewBag.Products[i]</p>
                <p><b>Price:</b> ₹@ViewBag.Prices[i]</p>
                <p><b>Size:</b> @ViewBag.Sizes[i]</p>
                <p><b>Color:</b> @ViewBag.Colors[i]</p>
                <p><b>Qty:</b> @ViewBag.Qtys[i]</p>

                <hr />
            }
        }
               <hr />

        <h3>Total: ₹@ViewBag.Total</h3>

        <h4 style="color:green">
            Discount : ₹@ViewBag.Discount
        </h4>

        <h3 style="color:red">
            Final Amount : ₹@ViewBag.FinalAmount
        </h3>

        //<h3>Debug Total: ₹@ViewBag.Debug</h3>//

        }

      <!--Common delivery for both-->
    <p style="margin-top:10px;">
        Estimated Delivery:
        @{
            var deliveryDate = DateTime.Now.AddDays(5);
        }
        @deliveryDate.ToString("dd MMM yyyy")
    </p>

    <br />

    <div style="text-align:center;">
        <a href="/Home/Address" class="btn btn-primary">Enter Address</a>
    </div>
    </div>
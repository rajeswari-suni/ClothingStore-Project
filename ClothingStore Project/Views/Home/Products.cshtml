@model IEnumerable<ClothingStore_Project.Models.Product>
@{
    var type = Context.Request.Query["type"].ToString();
}
<a href="/Login/Brands">⬅ Back to Brands</a>

<h2 style="text-align:center;">@ViewBag.Brand Products</h2>



@if (ViewBag.Products != null)
{
    foreach (var item in ViewBag.Products)
    {
        <div style="border:1px solid #ccc; padding:10px; margin:10px; width:200px;">
            <h4>@item</h4>
        </div>
    }
}

    <div style="display:flex;flex-wrap:wrap;gap:30px;">

        @foreach (var item in Model)
        {
            <div style="border:1px solid #ccc;
                    padding:10px;
                    width:220px;
                    text-align:center;">

                <img src="/images/@item.ImageUrl.Split(',')[0]"
                     width="150"
                     height="180" />

                <br />

                <h4>@item.ProductName</h4>

                <p>₹ @item.Price</p>

                <a href="/Home/ProductDetails?id=@item.ProductId">
                    View
                </a>

            </div>
        }
    </div>






















</div>
   
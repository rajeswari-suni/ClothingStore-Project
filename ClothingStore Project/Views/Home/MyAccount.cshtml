@{
    ViewData["Title"] = "My Account";
}

<div class="container mt-4">

    <h2>My Account</h2>
    <hr />

    <div class="card p-4">

        <h4>Welcome</h4>

        <p><strong>Role :</strong> @Context.Session.GetString("UserRole")</p>

        <a href="/Home/MyOrders" class="btn btn-outline-primary btn-lg w-100 mb-3">
            <i class="bi bi-box-seam"></i> My Orders
        </a>

        <a href="/Home/SavedAddresses" class="btn btn-outline-success btn-lg w-100 mb-3">
            <i class="bi bi-geo-alt-fill"></i> My Address
        </a>

        <a href="/Home/Logout" class="btn btn-outline-danger btn-lg w-100">
            <i class="bi bi-box-arrow-right"></i> Logout
        </a>

    </div>

</div>
@model ClothingStore_Project.Models.AddressDetails

<form asp-action="EditAddress" method="post">

    <input asp-for="Id" type="hidden" />

    <label>Name</label>
    <input asp-for="Name" class="form-control" />

    <label>Mobile</label>
    <input asp-for="Mobile" class="form-control" />

    <label>Door Number</label>
    <input asp-for="DoorNumber" class="form-control" />

    <label>Address</label>
    <input asp-for="AddressLine" class="form-control" />

    <label>City</label>
    <input asp-for="City" class="form-control" />

    <label>State</label>
    <input asp-for="State" class="form-control" />

    <label>Landmark</label>
    <input asp-for="Landmark" class="form-control" />

    <label>Pincode</label>
    <input asp-for="Pincode" class="form-control" />

    <br />

    <button type="submit" class="btn btn-success">
        Update Address
    </button>

</form>

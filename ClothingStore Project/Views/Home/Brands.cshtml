@{
    ViewData["Title"] = "Brands";
}

<h2 style="text-align:center;font-size:32px;
font-weight:bold;color:#2c3e50;
letter-spacing:2px;margin-bottom:20px;">
Select Brand
</h2>

<style>

.brand-container{
display:flex;
justify-content:center;
gap:50px;
margin-top:40px;
}

.brand-box{
text-align:center;
transition:0.3s;
padding:10px;
border-radius:10px;
}

.brand-box:hover{
transform:scale(1.1);
background-color:#f2f2f2;
}

.brand-name{
font-weight:bold;
font-size:16px;
margin-top:8px;
letter-spacing:1px;
color:#333;
}

.brand-logo{
width:80px;
height:80px;
object-fit:contain;
}

</style>

<div class="brand-container">

<div class="brand-box">
<a href="/Seller/AddProduct?brand=Puma" style="text-decoration:none;">
<img class="brand-logo"
                 src="https://www.freepnglogos.com/uploads/puma-logo-png-1.png">
</a>
<div class="brand-name">Puma</div>
</div>

<div class="brand-box">
<a href="/Seller/AddProduct?brand=Jockey" style="text-decoration:none;">
<img class="brand-logo"
                 src="https://cdn.iconscout.com/icon/free/png-256/free-jockey-underwear-logo-icon-svg-download-png-2854397.png">
</a>
<div class="brand-name">Jockey</div>
</div>

<div class="brand-box">
<a href="/Seller/AddProduct?brand=Levis" style="text-decoration:none;">
<img class="brand-logo"
                 src="https://upload.wikimedia.org/wikipedia/commons/thumb/8/87/Levis_logo_1892.png/250px-Levis_logo_1892.png">
</a>
<div class="brand-name">Levis</div>
</div>

<div class="brand-box">
<a href="/Seller/AddProduct?brand=Nike" style="text-decoration:none;">
<img class="brand-logo"
                 src="https://upload.wikimedia.org/wikipedia/commons/a/a6/Logo_NIKE.svg">
</a>
<div class="brand-name">Nike</div>
</div>

<div class="brand-box">
<a href="/Seller/AddProduct?brand=Wrangler" style="text-decoration:none;">
<img class="brand-logo"
                 src="https://cdn.vectorstock.com/i/1000v/40/09/horse-logo-vector-46584009.jpg">
</a>
<div class="brand-name">Wrangler</div>
</div>

</div>
